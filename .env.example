# En local, ne rien définir : l'app utilise un fichier SQLite local (data/echo.db).
# En production (Vercel, ou tout hébergeur sans disque persistant), crée une base
# Turso (https://turso.tech, gratuit) et renseigne ces deux variables :

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Pour l'email de réinitialisation de mot de passe (envoyé depuis Gmail).
# GMAIL_USER est optionnel (par défaut support.hejecho@gmail.com) ;
# GMAIL_APP_PASSWORD est un "mot de passe d'application" Google (pas le mot
# de passe normal du compte) — voir le README pour comment le générer.
# Sans cette variable, les demandes de reset sont acceptées mais l'email
# n'est simplement pas envoyé (erreur loggée côté serveur).
GMAIL_USER=support.hejecho@gmail.com
GMAIL_APP_PASSWORD=
